{
  "name": "dsh-zh-layer",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "DSH 的双语覆盖层：为插件、命令与 Skill 叠加中文名和功能说明，三种显示模式，英文原版一键开关。DSH Bilingual layer: Add Chinese names and descriptions for plugins, commands and Skills, with three display modes and one-click toggle to revert to the original English view.",
  "license": "MIT",
  "author": "Lin-AxiomSight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lin-AxiomSight/dsh-zh-layer.git"
  },
  "bugs": {
    "url": "https://github.com/Lin-AxiomSight/dsh-zh-layer/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "localization",
    "i18n",
    "translation",
    "zh-cn",
    "chinese",
    "zero-dependencies"
  ],
  "files": [
   "index.js",
   "client.js",
   "cordis.patch.yml",
   "README.md",
   "LICENSE",
   "CHANGELOG.md",
   "DEVELOPMENT.md",
   "images"
],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["slots"]
    }
  }
}